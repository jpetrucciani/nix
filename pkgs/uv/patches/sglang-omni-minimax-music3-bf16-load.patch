+def _move_state_to_device(
+    state: dict[str, Any], *, device: torch.device, dtype: torch.dtype
+) -> dict[str, Any]:
+    """Move checkpoint tensors at their final inference dtype."""
+
+    moved: dict[str, Any] = {}
+    for key, value in state.items():
+        if isinstance(value, Tensor):
+            moved[key] = value.to(
+                device=device,
+                dtype=dtype if value.is_floating_point() else value.dtype,
+            )
+        else:
+            moved[key] = value
+    return moved
+
