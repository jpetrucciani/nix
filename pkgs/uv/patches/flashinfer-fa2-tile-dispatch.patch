+// Match the explicit FA2 instantiations; discarded tiles must not emit references
+// to kernels omitted by the head-dimension-specific JIT templates.
+#define DISPATCH_CTA_TILE_Q_HEAD_DIMS(cta_tile_q, head_dim_qk, head_dim_vo, CTA_TILE_Q, ...) \
+  DISPATCH_CTA_TILE_Q(cta_tile_q, CTA_TILE_Q, {                                              \
+    if constexpr ((head_dim_vo >= 512 && (CTA_TILE_Q == 16 || CTA_TILE_Q == 32)) ||          \
+                  (head_dim_vo < 512 && head_dim_qk >= 512 && CTA_TILE_Q == 16) ||          \
+                  (head_dim_vo < 512 && head_dim_qk < 512 && CTA_TILE_Q != 32)) {           \
+      __VA_ARGS__                                                                         \
+    } else {                                                                              \
+      FLASHINFER_ERROR("CTA tile is not instantiated for these head dimensions");          \
+    }                                                                                     \
+  })
 
